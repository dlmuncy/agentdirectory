# MongoDB Connection (Required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=ai_agent_directory

# Site Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# Email Service (Currently Mocked - Optional for Phase 2)
# To integrate Resend:
# 1. Sign up at https://resend.com
# 2. Get API key
# 3. Uncomment and add your key below
# 4. Update lib/email.js to use Resend instead of console.log
# RESEND_API_KEY=re_your_api_key_here
# ADMIN_EMAIL=admin@yourdomain.com

# Supabase (Optional - For Phase 2 Authentication)
# To use Supabase:
# 1. Create project at https://supabase.com
# 2. Go to Project Settings → API
# 3. Copy your credentials and uncomment below
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Analytics (Optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
